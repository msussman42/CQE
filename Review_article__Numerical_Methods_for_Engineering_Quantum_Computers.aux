\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Illustration of Josephson qubit circuit\cite  {krantz2019quantum}. $L_{J}$ is the ``nonlinear inductance'' and is ``shunted'' by a capacitance, $C_{s}$. $L_{J}$, $C_{J}$, and the red hatched box is a substitute for a single inductor $L$ in order that the separation between the ground state $\mathinner {|{0}\rangle }$, first excited state, $\mathinner {|{1}\rangle }$, second excited state, $\mathinner {|{2}\rangle }$, etc. are not evenly spaced.  }}{4}{figure.1}\protected@file@percent }
\newlabel{transmon_circuit}{{1}{4}{Illustration of Josephson qubit circuit\cite {krantz2019quantum}. $L_{J}$ is the ``nonlinear inductance'' and is ``shunted'' by a capacitance, $C_{s}$. $L_{J}$, $C_{J}$, and the red hatched box is a substitute for a single inductor $L$ in order that the separation between the ground state $\ket {0}$, first excited state, $\ket {1}$, second excited state, $\ket {2}$, etc. are not evenly spaced}{figure.1}{}}
